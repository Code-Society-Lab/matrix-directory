DATABASE_URL=postgresql+psycopg://matrix:matrix@localhost:5432/matrix_directory
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=/api
APP_SECRET=replace-with-a-long-random-value
MATRIX_OIDC_ISSUER=https://account.matrix.org/
MATRIX_ACCOUNT_URL=https://account.matrix.org/account/
MATRIX_OIDC_CLIENT_ID=replace-with-your-registered-client-id
# MATRIX_OIDC_CLIENT_SECRET=only-if-the-registered-client-has-one
MATRIX_OIDC_REDIRECT_URI=https://your-public-host/api/auth/matrix/callback
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_OIDC_SCOPE=openid urn:matrix:client:api:*
# Required for Matrix login. Leave empty to run without it; an invalid value
# is rejected at startup rather than failing silently at login. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MATRIX_TOKEN_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=false  # set to true when using HTTPS in production
VITE_DOCS_URL=http://127.0.0.1:8001
